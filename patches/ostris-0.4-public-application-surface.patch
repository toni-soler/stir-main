diff --git a/backend/src/test/java/es/idynamicsax/ostris/service/ProvisioningAndDiscoveryPostgresTest.java b/backend/src/test/java/es/idynamicsax/ostris/service/ProvisioningAndDiscoveryPostgresTest.java
